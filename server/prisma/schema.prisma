generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InterviewStatus {
  ACTIVE
  EVALUATING
  COMPLETED
  FAILED
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interviews Interview[]
}

model Interview {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  role        String
  type        String
  difficulty  String?
  status      InterviewStatus @default(ACTIVE)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions  InterviewQuestion[]
  evaluation Evaluation?

  @@index([userId, createdAt])
  @@index([status])
}

model Question {
  id            String   @id @default(uuid()) @db.Uuid
  role          String
  type          String
  prompt        String   @db.Text
  correctAnswer String?  @db.Text
  explanation   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interviews InterviewQuestion[]

  @@index([role, type, isActive])
}

model InterviewQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  interviewId String   @db.Uuid
  questionId  String   @db.Uuid
  position    Int
  assignedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer    Answer?

  @@unique([interviewId, questionId])
  @@unique([interviewId, position])
  @@index([questionId])
}

model Answer {
  id                  String   @id @default(uuid()) @db.Uuid
  interviewQuestionId String   @unique @db.Uuid
  questionSnapshot    String   @db.Text
  response            String   @db.Text
  isCorrect           Boolean
  correctAnswer       String?  @db.Text
  submittedAt         DateTime @default(now())

  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id           String           @id @default(uuid()) @db.Uuid
  interviewId  String           @unique @db.Uuid
  status       EvaluationStatus @default(PENDING)
  score        Float?
  feedback     Json?
  errorMessage String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  completedAt  DateTime?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
